# ─────────────────────────────────────────────────────────────
# RLS Graphics System — variables de entorno
#
# Copia este archivo como .env y llena los valores.
# El .env NUNCA se sube a Git (está en .gitignore).
#
# Instrucciones completas de cada paso: ver README.md
# ─────────────────────────────────────────────────────────────

# ── Google Sheets ────────────────────────────────────────────
# ID de la planilla que hace de base de datos.
# Está en la URL: docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
# La primera hoja debe llamarse exactamente "Hoja 1", y hay que
# compartirla como Editor con el email de la service account.
GOOGLE_SHEET_ID=""

# ── Google Cloud Storage ─────────────────────────────────────
# Bucket donde se guardan las gráficas generadas.
# Necesita lectura pública (allUsers → Storage Object Viewer)
# para que Instagram pueda descargar las imágenes.
GCS_BUCKET=""

# ── Credenciales de Google ───────────────────────────────────
# EN LOCAL: deja el archivo google-credentials.json en la raíz
# del proyecto. Esta ruta ya apunta ahí por defecto.
GOOGLE_CREDENTIALS_PATH="./google-credentials.json"

# EN PRODUCCIÓN (Vercel): no uses la ruta de arriba. Crea una
# variable GOOGLE_CREDENTIALS_JSON y pega adentro el CONTENIDO
# COMPLETO del google-credentials.json, tal cual.
# GOOGLE_CREDENTIALS_JSON=""

# ── Gemini ───────────────────────────────────────────────────
# Genera el texto del post. Se saca en aistudio.google.com/apikey
# Si falta, la app funciona igual pero el caption queda vacío.
GEMINI_API_KEY=""

# ── Acceso ───────────────────────────────────────────────────
# Clave compartida entre los pilotos.
PILOT_PASSWORD=""

# Clave del administrador (da acceso al panel de aprobación).
ADMIN_PASSWORD=""

# Firma los tokens de sesión. Usa una cadena larga y aleatoria.
# Generar una:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si la cambias, se cierran todas las sesiones abiertas.
AUTH_SECRET=""
